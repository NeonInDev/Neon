{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemma-4-26b-a4b-it:free",
  "small_model": "openrouter/google/gemma-4-26b-a4b-it:free",
  "default_agent": "neon",
  "provider": {
    "openrouter": {
      "models": {
        "google/gemma-4-26b-a4b-it:free": {
          "name": "Gemma 4 26B A4B (Free)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    },
    "groq": {}
  },
  "agent": {
    "neon": {
      "mode": "primary",
      "description": "Neon - Bot de IA para Discord",
      "permission": { "edit": "allow", "bash": "allow" }
    }
  },
  "permission": { "bash": "allow", "edit": "allow" },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": false
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--headless", "--browser", "chrome"],
      "enabled": false
    },
    "pc": {
      "type": "local",
      "command": ["node", "src/pc.js"],
      "enabled": false
    },
    "celular": {
      "type": "local",
      "command": ["node", "src/mcp-celular.js"],
      "enabled": false
    },
    "system": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-system"],
      "enabled": false
    },
    "voice": {
      "type": "local",
      "command": ["node", "src/mcp-voz.js"],
      "enabled": false
    }
  }
}
