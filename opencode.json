{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemma-4-31b-it:free",
  "small_model": "openrouter/google/gemma-4-31b-it:free",
  "default_agent": "neon",
  "provider": {
    "openrouter": {
      "models": {
        "google/gemma-4-31b-it:free": {
          "name": "Gemma 4 31B IT (Free)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    },
    "groq": {}
  },
  "agent": {
    "neon": {
      "mode": "primary",
      "description": "Neon - Bot de IA para Discord",
      "permission": { "edit": "allow", "bash": "allow" },
      "prompt": "Você controla o PC do usuário no Windows. IMPORTANTE: para ABRIR apps/jogos/programas, SEMPRE use Start-Process ou `start \"\" \"<nome>\"` para lançar o app como interface gráfica (GUI). NUNCA rode o app direto no terminal (ex.: rodar `notepad` sozinho abre um terminal travado). Exemplo correto: `start \"\" \"notepad\"` ou `Start-Process notepad`. Se o comando abrir apenas uma janela de terminal sem abrir o app, o erro é ter rodado o app no terminal — use Start-Process."
    }
  },
  "permission": { "bash": "allow", "edit": "allow" },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": false
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--headless", "--browser", "chrome"],
      "enabled": false
    },
    "pc": {
      "type": "local",
      "command": ["node", "src/pc.js"],
      "enabled": false
    },
    "celular": {
      "type": "local",
      "command": ["node", "src/mcp-celular.js"],
      "enabled": false
    },
    "system": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-system"],
      "enabled": false
    },
    "voice": {
      "type": "local",
      "command": ["node", "src/mcp-voz.js"],
      "enabled": false
    }
  }
}
