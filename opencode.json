{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/qwen/qwen3-coder:free",
  "small_model": "openrouter/qwen/qwen3-coder:free",
  "default_agent": "neon",
  "provider": {
    "openrouter": {}
  },
  "agent": {
    "neon": {
      "mode": "primary",
      "description": "Neon - Bot de IA para Discord",
      "permission": { "edit": "allow", "bash": "allow" }
    }
  },
  "permission": { "bash": "allow", "edit": "allow" },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": false
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--headless", "--browser", "chrome"],
      "enabled": false
    },
    "pc": {
      "type": "local",
      "command": ["node", "src/pc.js"],
      "enabled": true
    },
    "celular": {
      "type": "local",
      "command": ["node", "src/mcp-celular.js"],
      "enabled": true
    },
    "system": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-system"],
      "enabled": false
    },
    "voice": {
      "type": "local",
      "command": ["node", "src/mcp-voz.js"],
      "enabled": true
    }
  }
}
